rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Datos de la app de cada entrenador (sincronización y fotos).
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Cuestionarios por enlace: el entrenador los crea y el cliente, sin cuenta,
    // solo puede añadir sus respuestas una única vez.
    match /cuestionarios/{token} {
      allow read: if true; // el enlace lleva un código aleatorio imposible de adivinar
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow update: if (request.auth != null && resource.data.owner == request.auth.uid)
        || (resource.data.answeredAt == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answers', 'answeredAt'])
            && request.resource.data.answers is list
            && request.resource.data.answers.size() <= 60);
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }

    // Zona del cliente (cliente.html): la publica el entrenador. El cliente la lee con su código
    // (aleatorio, imposible de adivinar) y, al crear su cuenta, solo puede apuntar quién es, una vez.
    match /portal/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow update: if (request.auth != null && resource.data.owner == request.auth.uid)
        || (request.auth != null
            && resource.data.get('memberUid', null) == null
            && request.resource.data.memberUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUid', 'memberEmail', 'joinedAt']));
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }

    // Diario de entrenamiento del cliente: lo escribe el cliente de esa zona y lo pueden ver él y su entrenador.
    match /portal/{token}/workouts/{wid} {
      allow read, write: if request.auth != null
        && (get(/databases/$(database)/documents/portal/$(token)).data.get('memberUid', null) == request.auth.uid
            || get(/databases/$(database)/documents/portal/$(token)).data.owner == request.auth.uid);
    }

    // Cuenta de cada cliente: qué zona es la suya. Solo la ve y la cambia él.
    match /members/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
